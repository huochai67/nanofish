# NoneBot
ENVIRONMENT=dev
HOST=0.0.0.0
PORT=8080
DRIVER=~fastapi+~websockets

# SUPERUSERS=["123456789"]

# acl plugin（角色 / 范围 / 配额）
# Docker Compose env_file: 不要把注释写在同一行（会被算进值里）！
# 正确: ACL_ALLOWED_GROUPS=[123456789]
# 错误: ACL_ALLOWED_GROUPS=[123456789]  # 这样会坏掉
# 空列表 [] = 不限制群
# ACL_ALLOWED_GROUPS=[123456789]
# ACL_ALLOW_PRIVATE=false
# ACL_ADMINS=[111222333]
# ACL_USER_WHITELIST=[]
# ACL_BLACKLIST=[]
# ACL_PERM_JRRP=guest
# ACL_PERM_LLM=user
# ACL_PERM_DRAW=user
# ACL_PERM_GENAI=user
# ACL_PERM_EH=admin
# ACL_PERM_IMGSEARCH=user
# ACL_PERM_PARSER=user
# ACL_PERM_HEALTH=superuser
# ACL_PERM_AUTH=admin
# ACL_QUOTA_LLM_DAILY=10
# ACL_QUOTA_DRAW_DAILY=5
# ACL_QUOTA_GENAI_DAILY=20
# ACL_QUOTA_EH_DAILY=20
# ACL_QUOTA_IMGSEARCH_DAILY=20
# ACL_COOLDOWN_LLM=30
# ACL_COOLDOWN_DRAW=60
# ACL_COOLDOWN_GENAI=10
# ACL_COOLDOWN_EH=10
# ACL_COOLDOWN_IMGSEARCH=10

# nonebot-plugin-parser（自动解析支持平台链接；受 ACL_PERM_PARSER 和 ACL 范围限制）
# 保持 base64 关闭，避免大媒体通过 OneBot WebSocket 时产生额外内存和带宽压力。
PARSER_MAX_SIZE=20
PARSER_DURATION_MAXIMUM=120
PARSER_USE_BASE64=false
PARSER_APPEND_URL=true
# 核心部署不包含 yt-dlp / Deno，先关闭这些高运营成本平台。
PARSER_DISABLED_PLATFORMS=["youtube","tiktok","twitter","nga"]
# 可选平台凭据与代理；仅填写到 .env/.env.prod，切勿提交。
# PARSER_BILI_CK=
# PARSER_XHS_CK=
# PARSER_YTB_CK=
# PARSER_PROXY=

# health plugin
# HEALTH_HTTP_TIMEOUT=5.0

# app plugin (screenshot frontend base URL)
# local dev: http://127.0.0.1:3000
# docker compose: overridden to http://frontend:3000
APP_API_BASE=http://127.0.0.1:3000
# APP_VIEWPORT_WIDTH=1366
# APP_VIEWPORT_HEIGHT=768
# APP_PAGE_TIMEOUT_MS=30000

# llm plugin (chat + image generate/edit)
MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-xxx
OPENAI_API_BASE=https://api.openai.com/v1
IMAGE_MODEL=dall-e-3
# IMAGE_SIZE=1024x1024
# IMAGE_RESPONSE_FORMAT=b64_json
# IMAGE_TIMEOUT=120

# genai_detect plugin
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
# 全部后端外部请求的代理（不代理 APP_API_BASE 前端探测）。
# PROXY=http://127.0.0.1:7890
# HTTP_PROXY=  # 兼容旧配置；PROXY 优先
# 输出所有共享 HTTP 客户端的脱敏请求与响应追踪日志；需要 LOG_LEVEL=DEBUG。
# HTTP_TRACE=true
# LOG_LEVEL=DEBUG

# ehsearch plugin (tag translation lives in the Next frontend)
EH_IPB_MEMBER_ID=
EH_IPB_PASS_HASH=
EH_SK=
EH_IGNEOUS=

# imgsearch plugin (SauceNAO is enabled by default; Soutubot needs an authorized key)
# IMGSEARCH_TIMEOUT=30
# IMGSEARCH_MAX_FILE_SIZE=8388608
# IMGSEARCH_RESULT_LIMIT=5
# IMGSEARCH_SAUCENAO_API_KEY=
# IMGSEARCH_SOUTUBOT_API_KEY=
# IMGSEARCH_SOUTUBOT_FACTOR=1.2
