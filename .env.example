# NoneBot 基础配置
ENVIRONMENT=dev
HOST=0.0.0.0
PORT=8080
DRIVER=~fastapi+~websockets
# SUPERUSERS=["123456789"]

# 全局网络与日志
# 全部后端外部请求的代理（不代理 APP_API_BASE 前端探测）。
# PROXY=http://127.0.0.1:7890
# FlareSolverr API 地址。Docker Compose 默认使用内部服务，无需设置。
# FLARESOLVERR_URL=http://flaresolverr:8191/v1
# 输出所有共享 HTTP 客户端的脱敏请求与响应追踪日志；需要 LOG_LEVEL=DEBUG。
# HTTP_TRACE=true
# LOG_LEVEL=DEBUG

# 截图页面插件（同时用于链接解析卡片）
# 本地开发: http://127.0.0.1:3000
# Docker Compose: 覆盖为 http://nanofish-frontend:3000
APP_API_BASE=http://127.0.0.1:3000
# APP_VIEWPORT_WIDTH=1366
# APP_VIEWPORT_HEIGHT=768
# APP_PAGE_TIMEOUT_MS=30000
# APP_DEBUG_FRONTEND_PAYLOAD=false
# APP_DEBUG_PAYLOAD_DIR=.cache/app-debug
